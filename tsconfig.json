{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["bun", "vite/client"],
    "paths": {
      "@/*": ["./web/src/*"],
      "@core/*": ["./core/*"]
    }
  },
  "include": ["cli", "core", "demo", "scripts", "web/src", "vite.config.ts"]
}
